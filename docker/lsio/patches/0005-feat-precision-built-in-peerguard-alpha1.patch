+
+    void testTemporaryEndpointAndIPMatching() const
+    {
+        BitTorrent::PeerEndpointBlocklist blocklist;
+        const qint64 future = QDateTime::currentMSecsSinceEpoch() + 60000;
+        const qint64 past = QDateTime::currentMSecsSinceEpoch() - 1;
+
+        blocklist.addTemporaryEndpoint(BitTorrent::PeerAddress::parse(u"1.1.1.1:1234"), future);
+        QVERIFY(blocklist.contains(BitTorrent::PeerAddress::parse(u"1.1.1.1:1234")));
+        QVERIFY(!blocklist.contains(BitTorrent::PeerAddress::parse(u"1.1.1.1:8526")));
+
+        blocklist.addTemporaryIP(QHostAddress(u"2.2.2.2"), future);
+        QVERIFY(blocklist.contains(BitTorrent::PeerAddress::parse(u"2.2.2.2:1234")));
+        QVERIFY(blocklist.contains(BitTorrent::PeerAddress::parse(u"2.2.2.2:8526")));
+
+        blocklist.pruneExpired(past);
+        QVERIFY(blocklist.contains(BitTorrent::PeerAddress::parse(u"2.2.2.2:8526")));
+        blocklist.pruneExpired(future);
+        QVERIFY(!blocklist.contains(BitTorrent::PeerAddress::parse(u"1.1.1.1:1234")));
+        QVERIFY(!blocklist.contains(BitTorrent::PeerAddress::parse(u"2.2.2.2:8526")));
+    }
