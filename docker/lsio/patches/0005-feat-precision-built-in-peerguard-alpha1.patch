index 0000000000000000000000000000000000000000..ed5459f8570c12580780d4dd4c78c9ee860ad689
--- /dev/null
+++ b/src/webui/api/peerbandercontroller.cpp
@@ -0,0 +1,239 @@
+/*
+ * qBittorrent Precision PeerBander Web API
+ * Copyright (C) 2026 qBittorrent Precision contributors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ */
+
+#include "peerbandercontroller.h"
+
+#include <algorithm>
+
+#include <QJsonArray>
+#include <QJsonObject>
+
+#include "base/bittorrent/peerbandermanager.h"
+#include "base/bittorrent/session.h"
+#include "base/global.h"
+#include "apierror.h"
+
+using namespace BitTorrent::PeerBander;
+
+namespace
+{
+    Manager *manager()
+    {
+        return BitTorrent::Session::instance()->peerBander();
+    }
+
+    bool parseBool(const QStringView value)
+    {
+        return (value == u"1") || (value.compare(u"true", Qt::CaseInsensitive) == 0)
+            || (value.compare(u"on", Qt::CaseInsensitive) == 0);
+    }
+
+    QJsonObject ruleToJson(const Rule &rule)
+    {
+        return
+        {
+            {u"id"_s, rule.id},
+            {u"enabled"_s, rule.enabled},
+            {u"priority"_s, rule.priority},
+            {u"clientFamily"_s, rule.clientFamily},
+            {u"clientVersion"_s, rule.clientVersion},
+            {u"peerId"_s, rule.peerIdPattern},
+            {u"ip"_s, rule.ipPattern},
+            {u"port"_s, rule.port},
+            {u"torrentHash"_s, rule.torrentHashPattern},
+            {u"action"_s, actionToString(rule.action)},
+            {u"comment"_s, rule.comment}
+        };
+    }
+
+    QJsonObject peerToJson(const PeerContext &peer)
+    {
+        return
+        {
+            {u"endpoint"_s, peer.endpoint.toString()},
+            {u"client"_s, peer.client},
+            {u"clientFamily"_s, peer.clientFamily},
+            {u"clientVersion"_s, peer.clientVersion},
+            {u"peerId"_s, peer.peerId},
+            {u"torrentHash"_s, peer.torrentHash},
+            {u"torrentName"_s, peer.torrentName},
+            {u"totalUpload"_s, peer.totalUpload},
+            {u"totalDownload"_s, peer.totalDownload},
+            {u"uploadSpeed"_s, peer.uploadSpeed},
+            {u"downloadSpeed"_s, peer.downloadSpeed}
+        };
+    }
+
+    QJsonObject decisionToJson(const Decision &decision)
+    {
+        return
+        {
+            {u"matched"_s, decision.matched},
+            {u"ruleId"_s, decision.ruleId},
+            {u"action"_s, actionToString(decision.action)},
+            {u"reason"_s, decision.reason}
+        };
+    }
+}
+
+void PeerBanderController::statusAction()
+{
+    const Manager *peerBander = manager();
+    setResult(QJsonObject
+    {
+        {u"version"_s, u"0.2.0-alpha.1"_s},
+        {u"mode"_s, u"event-driven-handshake"_s},
+        {u"available"_s, peerBander->isAvailable()},
+        {u"enabled"_s, peerBander->isEnabled()},
+        {u"scanInProgress"_s, peerBander->isScanInProgress()},
+        {u"lastScanTime"_s, peerBander->lastScanTime().toString(Qt::ISODateWithMs)},
+        {u"ruleCount"_s, peerBander->rules().size()},
+        {u"currentPeerCount"_s, peerBander->currentPeers().size()},
+        {u"eventCount"_s, peerBander->eventCount()},
+        {u"lastError"_s, peerBander->lastError()}
+    });
+}
+
+void PeerBanderController::rulesAction()
+{
+    QJsonArray result;
+    for (const Rule &rule : manager()->rules())
+        result.append(ruleToJson(rule));
+    setResult(result);
+}
+
+void PeerBanderController::peersAction()
+{
+    QJsonArray result;
+    for (const PeerContext &peer : manager()->currentPeers())
+    {
+        QJsonObject item = peerToJson(peer);
+        item[u"decision"_s] = decisionToJson(manager()->evaluate(peer));
+        result.append(item);
+    }
+    setResult(result);
+}
+
+void PeerBanderController::eventsAction()
+{
+    bool ok = true;
+    const int requestedLimit = params().value(u"limit"_s, u"100"_s).toInt(&ok);
+    if (!ok)
+        throw APIError(APIErrorType::BadParams, tr("'limit': invalid argument"));
+
+    QJsonArray result;
+    for (const Event &event : manager()->events(std::clamp(requestedLimit, 1, 1000)))
+    {
+        QJsonObject item = peerToJson(event.peer);
+        item[u"id"_s] = event.id;
+        item[u"timestamp"_s] = event.timestamp.toString(Qt::ISODateWithMs);
+        item[u"decision"_s] = decisionToJson(event.decision);
+        item[u"enforced"_s] = event.enforced;
+        result.append(item);
+    }
+    setResult(result);
+}
+
+void PeerBanderController::testRuleAction()
+{
+    requireParams({u"client"_s});
+
+    bool portOk = true;
+    const uint port = params().value(u"port"_s, u"0"_s).toUInt(&portOk);
+    if (!portOk || (port > 65535))
+        throw APIError(APIErrorType::BadParams, tr("'port': invalid argument"));
+
+    PeerContext peer
+    {
+        .endpoint = {.ip = QHostAddress(params().value(u"ip"_s)), .port = static_cast<ushort>(port)},
+        .client = params().value(u"client"_s),
+        .peerId = params().value(u"peerId"_s),
+        .torrentHash = params().value(u"torrentHash"_s)
+    };
+    const ClientIdentity identity = identifyClient(peer.client, peer.peerId);
+    peer.clientFamily = identity.family;
+    peer.clientVersion = identity.version;
+
+    QJsonObject result = peerToJson(peer);
+    result[u"decision"_s] = decisionToJson(manager()->evaluate(peer));
+    setResult(result);
+}
+
+void PeerBanderController::setEnabledAction()
+{
+    requireParams({u"enabled"_s});
+    if (!manager()->setEnabled(parseBool(params().value(u"enabled"_s))))
+        throw APIError(APIErrorType::Conflict, manager()->lastError());
+    setResult(QString());
+}
+
+void PeerBanderController::saveRuleAction()
+{
+    requireParams({u"clientFamily"_s, u"action"_s});
+
+    const std::optional<Action> action = actionFromString(params().value(u"action"_s));
+    if (!action)
+        throw APIError(APIErrorType::BadParams,
+            tr("'action': expected allow, observe, block_endpoint or block_ip"));
+
+    bool idOk = true;
+    bool priorityOk = true;
+    bool portOk = true;
+    const qint64 id = params().value(u"id"_s, u"0"_s).toLongLong(&idOk);
+    const int priority = params().value(u"priority"_s, u"0"_s).toInt(&priorityOk);
+    const uint port = params().value(u"port"_s, u"0"_s).toUInt(&portOk);
+    if (!idOk || (id < 0) || !priorityOk || !portOk || (port > 65535))
+        throw APIError(APIErrorType::BadParams, tr("Invalid numeric rule field"));
+
+    const Rule rule
+    {
+        .id = id,
+        .enabled = parseBool(params().value(u"enabled"_s, u"true"_s)),
+        .priority = priority,
+        .clientFamily = params().value(u"clientFamily"_s),
+        .clientVersion = params().value(u"clientVersion"_s, u"*"_s),
+        .peerIdPattern = params().value(u"peerId"_s, u"*"_s),
+        .ipPattern = params().value(u"ip"_s, u"*"_s),
+        .port = static_cast<ushort>(port),
+        .torrentHashPattern = params().value(u"torrentHash"_s, u"*"_s),
+        .action = *action,
+        .comment = params().value(u"comment"_s)
+    };
+
+    const qint64 savedId = manager()->saveRule(rule);
+    if (savedId <= 0)
+        throw APIError(APIErrorType::Conflict, manager()->lastError());
+    setResult(QJsonObject {{u"id"_s, savedId}});
+}
+
+void PeerBanderController::deleteRuleAction()
+{
+    requireParams({u"id"_s});
+    bool ok = false;
+    const qint64 id = params().value(u"id"_s).toLongLong(&ok);
+    if (!ok || (id <= 0))
+        throw APIError(APIErrorType::BadParams, tr("'id': invalid argument"));
+    if (!manager()->deleteRule(id))
+        throw APIError(APIErrorType::Conflict, manager()->lastError());
+    setResult(QString());
+}
+
+void PeerBanderController::clearEventsAction()
+{
+    if (!manager()->clearEvents())
+        throw APIError(APIErrorType::Conflict, manager()->lastError());
+    setResult(QString());
+}
+
+void PeerBanderController::scanNowAction()
+{
+    manager()->scanNow();
+    setResult(QString());
+}
