+/*
+ * qBittorrent Precision PeerBander
+ * Copyright (C) 2026 qBittorrent Precision contributors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ */
+
+#include "peerbandertypes.h"
+
+#include <QRegularExpression>
+
+#include "base/global.h"
+
+using namespace BitTorrent::PeerBander;
+
+QString BitTorrent::PeerBander::actionToString(const Action action)
+{
+    switch (action)
+    {
+    case Action::Allow:
+        return u"allow"_s;
+    case Action::Observe:
+        return u"observe"_s;
+    case Action::BlockEndpoint:
+        return u"block_endpoint"_s;
+    case Action::BlockIP:
+        return u"block_ip"_s;
+    }
+
+    return u"observe"_s;
+}
+
+std::optional<Action> BitTorrent::PeerBander::actionFromString(const QStringView value)
+{
+    if (value.compare(u"allow", Qt::CaseInsensitive) == 0)
+        return Action::Allow;
+    if (value.compare(u"observe", Qt::CaseInsensitive) == 0)
+        return Action::Observe;
+    // "block" was used by the unpublished prototype. Keep it as a safe
+    // endpoint-only alias when an early database is reused.
+    if ((value.compare(u"block", Qt::CaseInsensitive) == 0)
+        || (value.compare(u"block_endpoint", Qt::CaseInsensitive) == 0))
+    {
+        return Action::BlockEndpoint;
+    }
+    if (value.compare(u"block_ip", Qt::CaseInsensitive) == 0)
+        return Action::BlockIP;
+
+    return std::nullopt;
+}
+
+ClientIdentity BitTorrent::PeerBander::identifyClient(const QStringView client, const QStringView peerId)
+{
+    const QString normalized = client.toString().simplified();
+
+    static const QRegularExpression VERSION_PATTERN
+    {
+        u"(?:^|[^0-9])([0-9]+(?:\\.[0-9]+)+)(?=$|[^0-9])"_s
+    };
+
+    const QRegularExpressionMatch versionMatch = VERSION_PATTERN.match(normalized);
+    const QString version = versionMatch.hasMatch() ? versionMatch.captured(1) : QString();
+
+    const QString normalizedPeerId = peerId.toString().trimmed();
+    static const QRegularExpression XUNLEI_PEER_ID
+    {
+        u"^(?:-XL|-XU|-SD|-HP|-XM|-DT)|-RN0\\.0\\.0"_s,
+        QRegularExpression::CaseInsensitiveOption
+    };
+    const bool isXunleiPeerId = XUNLEI_PEER_ID.match(normalizedPeerId).hasMatch();
+    QString peerIdVersion;
+    if (isXunleiPeerId)
+    {
+        static const QRegularExpression XL_VERSION
+        {
+            u"^-XL([0-9]{4})"_s,
+            QRegularExpression::CaseInsensitiveOption
+        };
+        const QRegularExpressionMatch match = XL_VERSION.match(normalizedPeerId);
+        if (match.hasMatch())
+        {
+            const QString digits = match.captured(1);
+            peerIdVersion = u"%1.%2.%3.%4"_s
+                .arg(digits[0]).arg(digits[1]).arg(digits[2]).arg(digits[3]);
+        }
+    }
+
+    // libtorrent has emitted more than one display spelling for some clients.
+    // Normalize the known family without weakening the exact version match.
+    if (normalized.contains(u"xunlei", Qt::CaseInsensitive)
+        || normalized.contains(QString::fromUtf8("迅雷"), Qt::CaseInsensitive))
+    {
+        return {.family = u"Xunlei"_s, .version = version.isEmpty() ? peerIdVersion : version};
+    }
+
+    if (isXunleiPeerId)
+        return {.family = u"Xunlei"_s, .version = peerIdVersion};
+
+    if (normalized.isEmpty())
+        return {.family = u"Unknown"_s};
+
+    QString family = normalized;
+    if (versionMatch.hasMatch())
+    {
+        family = normalized.first(versionMatch.capturedStart()).trimmed();
+        while (!family.isEmpty() && QStringView(u"-_/vV ").contains(family.back()))
+            family.chop(1);
+    }
+
+    if (family.isEmpty())
+        family = normalized;
+
+    return {.family = family, .version = version};
+}
diff --git a/src/base/bittorrent/peerbandertypes.h b/src/base/bittorrent/peerbandertypes.h
