+ */
+
+#include "peerbandermanager.h"
+
+#include <algorithm>
+#include <chrono>
+
+#include <QTimer>
+
+#include "base/path.h"
+#include "base/profile.h"
+#include "session.h"
+
+using namespace std::chrono_literals;
+using namespace BitTorrent;
+using namespace BitTorrent::PeerBander;
+using namespace Qt::Literals::StringLiterals;
+
+Manager::Manager(Session *session, QObject *parent)
+    : QObject(parent)
+    , m_session {session}
+    , m_store {(specialFolderLocation(SpecialFolder::Data) / Path(u"peerguard.sqlite"_s)).data()}
+    , m_maintenanceTimer {new QTimer(this)}
+{
+    reloadRules();
+    m_runtimeEnabled.store(m_store.isEnabled(), std::memory_order_release);
+    m_maintenanceTimer->setInterval(10min);
+    connect(m_maintenanceTimer, &QTimer::timeout, this, &Manager::maintenance);
+    m_maintenanceTimer->start();
+}
+
+bool Manager::isAvailable() const
+{
+    return m_store.isAvailable();
+}
+
+QString Manager::lastError() const
+{
+    return m_store.lastError();
+}
+
+bool Manager::isEnabled() const
+{
+    return isRuntimeEnabled();
+}
+
+bool Manager::isRuntimeEnabled() const noexcept
+{
+    return m_runtimeEnabled.load(std::memory_order_acquire);
+}
+
+bool Manager::setEnabled(const bool enabled)
+{
+    if (!m_store.setEnabled(enabled))
+        return false;
+
+    m_runtimeEnabled.store(enabled, std::memory_order_release);
+    if (!enabled)
+    {
+        m_currentPeers.clear();
+        m_recentEvents.clear();
+    }
+    return true;
+}
+
+bool Manager::isScanInProgress() const
+{
+    return false;
+}
+
+QDateTime Manager::lastScanTime() const
+{
+    return m_lastScanTime;
+}
+
+QList<Rule> Manager::rules() const
+{
+    return m_engine.rules();
+}
+
+qint64 Manager::saveRule(const Rule &rule)
+{
+    const qint64 id = m_store.saveRule(rule);
+    if (id > 0)
+        reloadRules();
+    return id;
+}
+
+bool Manager::deleteRule(const qint64 id)
+{
+    if (!m_store.deleteRule(id))
+        return false;
+    reloadRules();
+    return true;
+}
+
+Decision Manager::evaluate(const PeerContext &peer) const
+{
+    PeerContext normalized = peer;
+    const ClientIdentity identity = identifyClient(peer.client, peer.peerId);
+    if (normalized.clientFamily.isEmpty())
+        normalized.clientFamily = identity.family;
+    if (normalized.clientVersion.isEmpty())
+        normalized.clientVersion = identity.version;
+    return m_engine.evaluate(normalized);
+}
+
+QList<PeerContext> Manager::currentPeers() const
+{
+    return m_currentPeers;
+}
+
+QList<Event> Manager::events(const int limit) const
+{
+    return m_store.loadEvents(limit);
+}
+
+int Manager::eventCount() const
+{
+    return m_store.eventCount();
+}
+
+bool Manager::clearEvents()
+{
+    return m_store.clearEvents();
+}
+
+void Manager::scanNow()
+{
+    // Kept as a compatibility no-op for the alpha Web API. PeerGuard is
+    // deliberately event-driven and never starts an all-torrent peer scan.
+}
+
+void Manager::reloadRules()
+{
+    m_engine.setRules(m_store.loadRules());
+}
+
+void Manager::observePeer(PeerContext peer)
+{
+    if (!isRuntimeEnabled() || peer.endpoint.ip.isNull() || (peer.endpoint.port == 0))
+        return;
+
+    const ClientIdentity identity = identifyClient(peer.client, peer.peerId);
+    peer.clientFamily = identity.family;
+    peer.clientVersion = identity.version;
+
+    const QString peerKey = u"%1|%2"_s.arg(peer.torrentHash, peer.endpoint.toString());
+    auto existingPeer = std::find_if(m_currentPeers.begin(), m_currentPeers.end(), [&peerKey](const PeerContext &item)
+    {
+        return u"%1|%2"_s.arg(item.torrentHash, item.endpoint.toString()) == peerKey;
+    });
+    if (existingPeer != m_currentPeers.end())
+        *existingPeer = peer;
+    else
+        m_currentPeers.append(peer);
+    while (m_currentPeers.size() > 500)
+        m_currentPeers.removeFirst();
+
+    const Decision decision = m_engine.evaluate(peer);
+    m_lastScanTime = QDateTime::currentDateTimeUtc();
+    if (!decision.matched)
+        return;
+
+    constexpr qint64 BLOCK_DURATION_SECONDS = 7 * 24 * 60 * 60;
+    const qint64 expiresAt = m_lastScanTime.addSecs(BLOCK_DURATION_SECONDS).toMSecsSinceEpoch();
+    bool enforced = false;
+    if (decision.action == Action::BlockEndpoint)
+    {
+        m_session->blockPeerEndpointTemporarily(peer.endpoint, expiresAt);
+        enforced = true;
+    }
+    else if (decision.action == Action::BlockIP)
+    {
+        m_session->blockPeerIPTemporarily(peer.endpoint.ip, expiresAt);
+        enforced = true;
+    }
+
+    const QString decisionKey = u"%1|%2|%3|%4"_s
+        .arg(peer.torrentHash, peer.endpoint.toString())
+        .arg(decision.ruleId)
+        .arg(actionToString(decision.action));
+    constexpr qint64 EVENT_COOLDOWN_MSECS = 10 * 60 * 1000;
+    const QDateTime previousEvent = m_recentEvents.value(decisionKey);
+    if (!previousEvent.isValid() || (previousEvent.msecsTo(m_lastScanTime) >= EVENT_COOLDOWN_MSECS))
+    {
+        m_store.addEvent(
+        {
+            .timestamp = m_lastScanTime,
+            .peer = peer,
+            .decision = decision,
+            .enforced = enforced
+        });
+        m_recentEvents.insert(decisionKey, m_lastScanTime);
+    }
+}
+
+void Manager::maintenance()
+{
+    const QDateTime now = QDateTime::currentDateTimeUtc();
+    m_session->pruneTemporaryPeerBlocks(now.toMSecsSinceEpoch());
+
+    for (auto it = m_recentEvents.begin(); it != m_recentEvents.end();)
+    {
+        if (it.value().msecsTo(now) >= (10 * 60 * 1000))
+            it = m_recentEvents.erase(it);
+        else
+            ++it;
+    }
+}
