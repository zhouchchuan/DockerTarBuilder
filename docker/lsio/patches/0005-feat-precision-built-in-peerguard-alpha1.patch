@@ -0,0 +1,374 @@
+/*
+ * qBittorrent Precision PeerBander
+ * Copyright (C) 2026 qBittorrent Precision contributors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ */
+
+#include "peerbanderstore.h"
+
+#include <algorithm>
+
+#include <QSqlError>
+#include <QSqlQuery>
+#include <QVariant>
+
+#include "base/global.h"
+
+using namespace BitTorrent::PeerBander;
+
+namespace
+{
+    constexpr int MAX_STORED_EVENTS = 5000;
+
+    Rule readRule(const QSqlQuery &query)
+    {
+        return
+        {
+            .id = query.value(u"id"_s).toLongLong(),
+            .enabled = query.value(u"enabled"_s).toBool(),
+            .priority = query.value(u"priority"_s).toInt(),
+            .clientFamily = query.value(u"client_family"_s).toString(),
+            .clientVersion = query.value(u"client_version"_s).toString(),
+            .peerIdPattern = query.value(u"peer_id_pattern"_s).toString(),
+            .ipPattern = query.value(u"ip_pattern"_s).toString(),
+            .port = static_cast<ushort>(query.value(u"port"_s).toUInt()),
+            .torrentHashPattern = query.value(u"torrent_hash_pattern"_s).toString(),
+            .action = actionFromString(query.value(u"action"_s).toString()).value_or(Action::Observe),
+            .comment = query.value(u"comment"_s).toString()
+        };
+    }
+
+    void bindRule(QSqlQuery &query, const Rule &rule)
+    {
+        query.bindValue(u":enabled"_s, rule.enabled);
+        query.bindValue(u":priority"_s, rule.priority);
+        query.bindValue(u":client_family"_s, rule.clientFamily.isEmpty() ? u"*"_s : rule.clientFamily);
+        query.bindValue(u":client_version"_s, rule.clientVersion.isEmpty() ? u"*"_s : rule.clientVersion);
+        query.bindValue(u":peer_id_pattern"_s, rule.peerIdPattern.isEmpty() ? u"*"_s : rule.peerIdPattern);
+        query.bindValue(u":ip_pattern"_s, rule.ipPattern.isEmpty() ? u"*"_s : rule.ipPattern);
+        query.bindValue(u":port"_s, rule.port);
+        query.bindValue(u":torrent_hash_pattern"_s, rule.torrentHashPattern.isEmpty() ? u"*"_s : rule.torrentHashPattern);
+        query.bindValue(u":action"_s, actionToString(rule.action));
+        query.bindValue(u":comment"_s, rule.comment);
+    }
+}
+
+Store::Store(const QString &databasePath)
+    : m_connectionName {u"PeerBander_%1"_s.arg(reinterpret_cast<quintptr>(this))}
+    , m_database {QSqlDatabase::addDatabase(u"QSQLITE"_s, m_connectionName)}
+{
+    m_database.setDatabaseName(databasePath);
+    if (!m_database.open())
+    {
+        setError(m_database.lastError().text());
+        return;
+    }
+
+    m_available = initialize();
+}
+
+Store::~Store()
+{
+    if (m_database.isOpen())
+        m_database.close();
+    m_database = {};
+    QSqlDatabase::removeDatabase(m_connectionName);
+}
+
+bool Store::isAvailable() const
+{
+    return m_available;
+}
+
+QString Store::lastError() const
+{
+    return m_lastError;
+}
+
+bool Store::initialize()
+{
+    QSqlQuery query {m_database};
+    const QStringList statements
+    {
+        u"CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT NOT NULL);"_s,
+        u"CREATE TABLE IF NOT EXISTS rules ("
+            "id INTEGER PRIMARY KEY AUTOINCREMENT, enabled INTEGER NOT NULL, priority INTEGER NOT NULL, "
+            "client_family TEXT NOT NULL, client_version TEXT NOT NULL, peer_id_pattern TEXT NOT NULL, "
+            "ip_pattern TEXT NOT NULL, port INTEGER NOT NULL, torrent_hash_pattern TEXT NOT NULL, "
+            "action TEXT NOT NULL, comment TEXT NOT NULL);"_s,
+        u"CREATE TABLE IF NOT EXISTS events ("
+            "id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp INTEGER NOT NULL, endpoint TEXT NOT NULL, "
+            "client TEXT NOT NULL, client_family TEXT NOT NULL, client_version TEXT NOT NULL, "
+            "peer_id TEXT NOT NULL, torrent_hash TEXT NOT NULL, torrent_name TEXT NOT NULL, "
+            "rule_id INTEGER NOT NULL, action TEXT NOT NULL, reason TEXT NOT NULL, enforced INTEGER NOT NULL);"_s,
+        u"CREATE INDEX IF NOT EXISTS events_timestamp_idx ON events(timestamp DESC);"_s,
+        u"INSERT OR IGNORE INTO settings(key, value) VALUES('enabled', '0');"_s
+    };
+
+    for (const QString &statement : statements)
+    {
+        if (!query.exec(statement))
+        {
+            setError(query.lastError().text());
+            return false;
+        }
+    }
+
+    return seedDefaultRules();
+}
+
+bool Store::seedDefaultRules()
+{
+    QSqlQuery countQuery {m_database};
+    if (!countQuery.exec(u"SELECT COUNT(*) FROM rules;"_s) || !countQuery.next())
+    {
+        setError(countQuery.lastError().text());
+        return false;
+    }
+    if (countQuery.value(0).toInt() > 0)
+        return true;
+
+    const QList<Rule> defaults
+    {
+        {.priority = 100, .clientFamily = u"Xunlei"_s, .clientVersion = u"0.0.1.9"_s, .action = Action::Allow,
+            .comment = u"Allow configured Xunlei version 0.0.1.9"_s},
+        {.priority = 100, .clientFamily = u"Xunlei"_s, .clientVersion = u"0.0.1.8"_s, .action = Action::Allow,
+            .comment = u"Allow configured Xunlei version 0.0.1.8"_s},
+        {.priority = 50, .clientFamily = u"Gopeed*"_s, .clientVersion = u"*"_s, .action = Action::BlockIP,
+            .comment = u"Block confirmed Gopeed leecher family by IP"_s},
+        {.priority = 10, .clientFamily = u"Xunlei"_s, .clientVersion = u"*"_s, .action = Action::BlockEndpoint,
+            .comment = u"Block other Xunlei versions by exact endpoint"_s}
+    };
+
+    if (!m_database.transaction())
+    {
+        setError(m_database.lastError().text());
+        return false;
+    }
+
+    for (const Rule &rule : defaults)
+    {
+        if (saveRule(rule) <= 0)
+        {
+            m_database.rollback();
+            return false;
+        }
+    }
+
+    if (!m_database.commit())
+    {
+        setError(m_database.lastError().text());
+        return false;
+    }
+    return true;
+}
+
+bool Store::isEnabled() const
+{
+    if (!m_available)
+        return false;
+
+    QSqlQuery query {m_database};
+    query.prepare(u"SELECT value FROM settings WHERE key = 'enabled';"_s);
+    if (!query.exec() || !query.next())
+    {
+        setError(query.lastError().text());
+        return false;
+    }
+    return query.value(0).toInt() != 0;
+}
+
+bool Store::setEnabled(const bool enabled)
+{
+    if (!m_available)
+        return false;
+
+    QSqlQuery query {m_database};
+    query.prepare(u"INSERT OR REPLACE INTO settings(key, value) VALUES('enabled', :value);"_s);
+    query.bindValue(u":value"_s, enabled ? u"1"_s : u"0"_s);
+    if (!query.exec())
+    {
+        setError(query.lastError().text());
+        return false;
+    }
+    return true;
+}
+
+QList<Rule> Store::loadRules() const
+{
+    QList<Rule> rules;
+    if (!m_available)
+        return rules;
+
+    QSqlQuery query {m_database};
+    if (!query.exec(u"SELECT * FROM rules ORDER BY priority DESC, id ASC;"_s))
+    {
+        setError(query.lastError().text());
+        return rules;
+    }
+    while (query.next())
+        rules.append(readRule(query));
+    return rules;
+}
+
+qint64 Store::saveRule(const Rule &rule)
+{
+    if (!m_database.isOpen())
+        return 0;
+
+    QSqlQuery query {m_database};
+    if (rule.id > 0)
+    {
+        query.prepare(u"UPDATE rules SET enabled=:enabled, priority=:priority, client_family=:client_family, "
+            "client_version=:client_version, peer_id_pattern=:peer_id_pattern, ip_pattern=:ip_pattern, "
+            "port=:port, torrent_hash_pattern=:torrent_hash_pattern, action=:action, comment=:comment WHERE id=:id;"_s);
+        query.bindValue(u":id"_s, rule.id);
+    }
+    else
+    {
+        query.prepare(u"INSERT INTO rules(enabled, priority, client_family, client_version, peer_id_pattern, "
+            "ip_pattern, port, torrent_hash_pattern, action, comment) VALUES(:enabled, :priority, :client_family, "
+            ":client_version, :peer_id_pattern, :ip_pattern, :port, :torrent_hash_pattern, :action, :comment);"_s);
+    }
+    bindRule(query, rule);
+
+    if (!query.exec())
+    {
+        setError(query.lastError().text());
+        return 0;
+    }
+    return (rule.id > 0) ? rule.id : query.lastInsertId().toLongLong();
+}
+
+bool Store::deleteRule(const qint64 id)
+{
+    if (!m_available)
+        return false;
+
+    QSqlQuery query {m_database};
+    query.prepare(u"DELETE FROM rules WHERE id=:id;"_s);
+    query.bindValue(u":id"_s, id);
+    if (!query.exec())
+    {
+        setError(query.lastError().text());
+        return false;
+    }
+    return query.numRowsAffected() > 0;
+}
+
+bool Store::addEvent(const Event &event)
+{
+    if (!m_available)
+        return false;
+
+    QSqlQuery query {m_database};
+    query.prepare(u"INSERT INTO events(timestamp, endpoint, client, client_family, client_version, peer_id, "
+        "torrent_hash, torrent_name, rule_id, action, reason, enforced) VALUES(:timestamp, :endpoint, :client, "
+        ":client_family, :client_version, :peer_id, :torrent_hash, :torrent_name, :rule_id, :action, :reason, :enforced);"_s);
+    query.bindValue(u":timestamp"_s, event.timestamp.toMSecsSinceEpoch());
+    query.bindValue(u":endpoint"_s, event.peer.endpoint.toString());
+    query.bindValue(u":client"_s, event.peer.client);
+    query.bindValue(u":client_family"_s, event.peer.clientFamily);
+    query.bindValue(u":client_version"_s, event.peer.clientVersion);
+    query.bindValue(u":peer_id"_s, event.peer.peerId);
+    query.bindValue(u":torrent_hash"_s, event.peer.torrentHash);
+    query.bindValue(u":torrent_name"_s, event.peer.torrentName);
+    query.bindValue(u":rule_id"_s, event.decision.ruleId);
+    query.bindValue(u":action"_s, actionToString(event.decision.action));
+    query.bindValue(u":reason"_s, event.decision.reason);
+    query.bindValue(u":enforced"_s, event.enforced);
+    if (!query.exec())
+    {
+        setError(query.lastError().text());
+        return false;
+    }
+
+    QSqlQuery trimQuery {m_database};
+    trimQuery.prepare(u"DELETE FROM events WHERE id NOT IN (SELECT id FROM events ORDER BY id DESC LIMIT :limit);"_s);
+    trimQuery.bindValue(u":limit"_s, MAX_STORED_EVENTS);
+    if (!trimQuery.exec())
+        setError(trimQuery.lastError().text());
+    return true;
+}
+
+QList<Event> Store::loadEvents(const int limit) const
+{
+    QList<Event> events;
+    if (!m_available)
+        return events;
+
+    QSqlQuery query {m_database};
+    query.prepare(u"SELECT * FROM events ORDER BY id DESC LIMIT :limit;"_s);
+    query.bindValue(u":limit"_s, std::clamp(limit, 1, 1000));
+    if (!query.exec())
+    {
+        setError(query.lastError().text());
+        return events;
+    }
+
+    while (query.next())
+    {
+        const PeerAddress endpoint = PeerAddress::parse(query.value(u"endpoint"_s).toString());
+        events.append(
+        {
+            .id = query.value(u"id"_s).toLongLong(),
+            .timestamp = QDateTime::fromMSecsSinceEpoch(query.value(u"timestamp"_s).toLongLong()),
+            .peer =
+            {
+                .endpoint = endpoint,
+                .client = query.value(u"client"_s).toString(),
+                .clientFamily = query.value(u"client_family"_s).toString(),
+                .clientVersion = query.value(u"client_version"_s).toString(),
+                .peerId = query.value(u"peer_id"_s).toString(),
+                .torrentHash = query.value(u"torrent_hash"_s).toString(),
+                .torrentName = query.value(u"torrent_name"_s).toString()
+            },
+            .decision =
+            {
+                .action = actionFromString(query.value(u"action"_s).toString()).value_or(Action::Observe),
+                .ruleId = query.value(u"rule_id"_s).toLongLong(),
+                .reason = query.value(u"reason"_s).toString(),
+                .matched = true
+            },
+            .enforced = query.value(u"enforced"_s).toBool()
+        });
+    }
+    return events;
+}
+
+int Store::eventCount() const
+{
+    if (!m_available)
+        return 0;
+
+    QSqlQuery query {m_database};
+    if (!query.exec(u"SELECT COUNT(*) FROM events;"_s) || !query.next())
+    {
+        setError(query.lastError().text());
+        return 0;
+    }
+    return query.value(0).toInt();
+}
+
+bool Store::clearEvents()
+{
+    if (!m_available)
+        return false;
+
+    QSqlQuery query {m_database};
+    if (!query.exec(u"DELETE FROM events;"_s))
+    {
+        setError(query.lastError().text());
+        return false;
+    }
+    return true;
+}
+
+void Store::setError(const QString &error) const
+{
+    m_lastError = error;
+}
