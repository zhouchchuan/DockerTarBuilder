@@ -0,0 +1,82 @@
+/*
+ * qBittorrent Precision PeerBander
+ * Copyright (C) 2026 qBittorrent Precision contributors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ */
+
+#include "peerbanderruleengine.h"
+
+#include <algorithm>
+
+#include <QRegularExpression>
+
+#include "base/global.h"
+
+using namespace BitTorrent::PeerBander;
+
+void RuleEngine::setRules(QList<Rule> rules)
+{
+    std::stable_sort(rules.begin(), rules.end(), [](const Rule &left, const Rule &right)
+    {
+        if (left.priority != right.priority)
+            return left.priority > right.priority;
+        return left.id < right.id;
+    });
+    m_rules = std::move(rules);
+}
+
+const QList<Rule> &RuleEngine::rules() const
+{
+    return m_rules;
+}
+
+Decision RuleEngine::evaluate(const PeerContext &peer) const
+{
+    for (const Rule &rule : m_rules)
+    {
+        if (!rule.enabled || !matches(rule, peer))
+            continue;
+
+        return
+        {
+            .action = rule.action,
+            .ruleId = rule.id,
+            .reason = u"Matched rule %1 (%2)"_s.arg(rule.id).arg(rule.comment),
+            .matched = true
+        };
+    }
+
+    return
+    {
+        .action = Action::Observe,
+        .reason = u"No rule matched"_s,
+        .matched = false
+    };
+}
+
+bool RuleEngine::matches(const Rule &rule, const PeerContext &peer)
+{
+    return wildcardMatch(rule.clientFamily, peer.clientFamily)
+        && wildcardMatch(rule.clientVersion, peer.clientVersion)
+        && wildcardMatch(rule.peerIdPattern, peer.peerId)
+        && wildcardMatch(rule.ipPattern, peer.endpoint.ip.toString())
+        && ((rule.port == 0) || (rule.port == peer.endpoint.port))
+        && wildcardMatch(rule.torrentHashPattern, peer.torrentHash);
+}
+
+bool RuleEngine::wildcardMatch(const QStringView pattern, const QStringView value)
+{
+    if (pattern.isEmpty() || (pattern == u"*"))
+        return true;
+
+    const QRegularExpression expression
+    {
+        QRegularExpression::wildcardToRegularExpression(pattern.toString()),
+        QRegularExpression::CaseInsensitiveOption
+    };
+    return expression.match(value).hasMatch();
+}
