+using namespace BitTorrent::PeerBander;
+using namespace Qt::Literals::StringLiterals;
+
+class TestPeerBanderRuleEngine final : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void testClientIdentity();
+    void testXunleiPeerIdIdentity();
+    void testVersionAllowOverridesFamilyBlock();
+    void testBlockScopes();
+    void testEndpointAndPeerIdMatch();
+    void testUnknownPeerDefaultsToObserve();
+};
+
+void TestPeerBanderRuleEngine::testClientIdentity()
+{
+    const ClientIdentity xunlei = identifyClient(u"Xunlei 0.0.1.9");
+    QCOMPARE(xunlei.family, u"Xunlei");
+    QCOMPARE(xunlei.version, u"0.0.1.9");
+
+    const ClientIdentity transmission = identifyClient(u"Transmission 4.0.6");
+    QCOMPARE(transmission.family, u"Transmission");
+    QCOMPARE(transmission.version, u"4.0.6");
+}
+
+void TestPeerBanderRuleEngine::testXunleiPeerIdIdentity()
+{
+    const ClientIdentity xunlei = identifyClient({}, u"-XL0019-");
+    QCOMPARE(xunlei.family, u"Xunlei");
+    QCOMPARE(xunlei.version, u"0.0.1.9");
+
+    const ClientIdentity namedXunlei = identifyClient(u"Xunlei", u"-XL0018-");
+    QCOMPARE(namedXunlei.family, u"Xunlei");
+    QCOMPARE(namedXunlei.version, u"0.0.1.8");
+}
+
+void TestPeerBanderRuleEngine::testVersionAllowOverridesFamilyBlock()
+{
+    RuleEngine engine;
+    engine.setRules(
+    {
+        {.id = 1, .priority = 100, .clientFamily = u"Xunlei"_s, .clientVersion = u"0.0.1.9"_s, .action = Action::Allow},
+        {.id = 2, .priority = 100, .clientFamily = u"Xunlei"_s, .clientVersion = u"0.0.1.8"_s, .action = Action::Allow},
+        {.id = 3, .priority = 10, .clientFamily = u"Xunlei"_s, .clientVersion = u"*"_s, .action = Action::BlockEndpoint}
+    });
+
+    PeerContext peer {.clientFamily = u"Xunlei"_s, .clientVersion = u"0.0.1.9"_s};
+    QCOMPARE(engine.evaluate(peer).action, Action::Allow);
+
+    peer.clientVersion = u"0.0.1.7"_s;
+    const Decision blocked = engine.evaluate(peer);
+    QCOMPARE(blocked.action, Action::BlockEndpoint);
+    QCOMPARE(blocked.ruleId, 3);
+}
+
+void TestPeerBanderRuleEngine::testBlockScopes()
+{
+    RuleEngine engine;
+    engine.setRules(
+    {
+        {.id = 1, .priority = 50, .clientFamily = u"Gopeed*"_s, .action = Action::BlockIP},
+        {.id = 2, .priority = 10, .clientFamily = u"Xunlei"_s, .action = Action::BlockEndpoint}
+    });
+
+    QCOMPARE(engine.evaluate({.clientFamily = u"Gopeed dev"_s}).action, Action::BlockIP);
+    QCOMPARE(engine.evaluate({.clientFamily = u"Xunlei"_s}).action, Action::BlockEndpoint);
+}
+
+void TestPeerBanderRuleEngine::testEndpointAndPeerIdMatch()
+{
+    RuleEngine engine;
+    engine.setRules(
+    {
+        {
+            .id = 4,
+            .priority = 50,
+            .clientFamily = u"*"_s,
+            .clientVersion = u"*"_s,
+            .peerIdPattern = u"-XL*"_s,
+            .ipPattern = u"192.0.2.*"_s,
+            .port = 6881,
+            .action = Action::BlockEndpoint
+        }
+    });
+
+    const PeerContext matching
+    {
+        .endpoint = {.ip = QHostAddress(u"192.0.2.8"), .port = 6881},
+        .peerId = u"-XL0019-"_s
+    };
+    QCOMPARE(engine.evaluate(matching).action, Action::BlockEndpoint);
+
+    PeerContext otherPort = matching;
+    otherPort.endpoint.port = 6882;
+    QCOMPARE(engine.evaluate(otherPort).action, Action::Observe);
+}
+
+void TestPeerBanderRuleEngine::testUnknownPeerDefaultsToObserve()
+{
+    RuleEngine engine;
+    engine.setRules({{.id = 1, .clientFamily = u"Xunlei"_s, .action = Action::BlockEndpoint}});
+
+    const PeerContext peer {.clientFamily = u"qBittorrent"_s, .clientVersion = u"5.2.3"_s};
+    const Decision decision = engine.evaluate(peer);
+    QCOMPARE(decision.action, Action::Observe);
+    QVERIFY(!decision.matched);
+}
+
