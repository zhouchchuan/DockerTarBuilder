+void SessionImpl::banPeerEndpoint(const PeerAddress &endpoint)
+{
+    if (endpoint.ip.isNull() || (endpoint.port == 0))
+        return;
+
+    const QString endpointString = endpoint.toString();
+    if (m_bannedPeerEndpoints.get().contains(endpointString))
+        return;
+
+    m_nativeSessionExtension->banPeerEndpoint(endpoint);
+
+    QStringList endpoints = m_bannedPeerEndpoints;
+    endpoints.append(endpointString);
+    endpoints.sort();
+    m_bannedPeerEndpoints = endpoints;
+}
+
+QStringList SessionImpl::bannedPeerEndpoints() const
+{
+    return m_bannedPeerEndpoints;
+}
+
+void SessionImpl::setBannedPeerEndpoints(const QStringList &endpoints)
+{
+    QStringList normalizedEndpoints;
+    normalizedEndpoints.reserve(endpoints.size());
+
+    for (const QString &endpoint : endpoints)
+    {
+        const PeerAddress peerAddress = PeerAddress::parse(endpoint.trimmed());
+        if (!peerAddress.ip.isNull() && (peerAddress.port != 0))
+            normalizedEndpoints.append(peerAddress.toString());
+    }
+
+    normalizedEndpoints.removeDuplicates();
+    normalizedEndpoints.sort();
+    if (normalizedEndpoints == m_bannedPeerEndpoints)
+        return;
+
+    m_nativeSessionExtension->setBannedPeerEndpoints(normalizedEndpoints);
+    m_bannedPeerEndpoints = normalizedEndpoints;
+}
