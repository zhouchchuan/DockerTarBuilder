+#include <QObject>
+#include <QTest>
+
+#include "base/bittorrent/peerendpointblocklist.h"
+
+using namespace Qt::Literals::StringLiterals;
+
+class TestBittorrentPeerEndpointBlocklist final : public QObject
+{
+    Q_OBJECT
+    Q_DISABLE_COPY_MOVE(TestBittorrentPeerEndpointBlocklist)
+
+private slots:
+    void testExactEndpointMatching() const
+    {
+        BitTorrent::PeerEndpointBlocklist blocklist;
+        blocklist.replace({u"1.1.1.1:1234"_s, u"[2001:db8::1]:6881"_s});
+
+        QVERIFY(blocklist.contains(BitTorrent::PeerAddress::parse(u"1.1.1.1:1234")));
+        QVERIFY(!blocklist.contains(BitTorrent::PeerAddress::parse(u"1.1.1.1:8526")));
+        QVERIFY(!blocklist.contains(BitTorrent::PeerAddress::parse(u"2.2.2.2:1234")));
+        QVERIFY(blocklist.contains(BitTorrent::PeerAddress::parse(u"[2001:db8::1]:6881")));
+        QVERIFY(!blocklist.contains(BitTorrent::PeerAddress::parse(u"[2001:db8::1]:6882")));
+    }
+
+    void testReplaceAndValidation() const
+    {
+        BitTorrent::PeerEndpointBlocklist blocklist;
+        blocklist.add(BitTorrent::PeerAddress::parse(u"1.1.1.1:1234"));
+        QVERIFY(blocklist.contains(BitTorrent::PeerAddress::parse(u"1.1.1.1:1234")));
+
+        blocklist.replace({u"invalid"_s, u"2.2.2.2:4321"_s, u"2.2.2.2:4321"_s});
+        QVERIFY(!blocklist.contains(BitTorrent::PeerAddress::parse(u"1.1.1.1:1234")));
