+
+#include "peerendpointblocklist.h"
+
+#include <utility>
+
+#include <QStringList>
+
+using namespace BitTorrent;
+
+bool PeerEndpointBlocklist::contains(const PeerAddress &endpoint) const
+{
+    const QReadLocker locker {&m_lock};
+    return m_endpoints.contains(endpoint);
+}
+
+void PeerEndpointBlocklist::add(const PeerAddress &endpoint)
+{
+    if (endpoint.ip.isNull() || (endpoint.port == 0))
+        return;
+
+    const QWriteLocker locker {&m_lock};
+    m_endpoints.insert(endpoint);
+}
+
+void PeerEndpointBlocklist::replace(const QStringList &endpoints)
+{
+    QSet<PeerAddress> parsedEndpoints;
+    for (const QString &endpoint : endpoints)
+    {
+        const PeerAddress peerAddress = PeerAddress::parse(endpoint.trimmed());
+        if (!peerAddress.ip.isNull() && (peerAddress.port != 0))
+            parsedEndpoints.insert(peerAddress);
+    }
+
+    const QWriteLocker locker {&m_lock};
+    m_endpoints = std::move(parsedEndpoints);
+}
