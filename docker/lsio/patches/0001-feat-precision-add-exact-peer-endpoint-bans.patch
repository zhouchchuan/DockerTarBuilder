+    class NativePeerExtension final : public lt::peer_plugin
+    {
+    public:
+        NativePeerExtension(const lt::peer_connection_handle &connection
+            , std::shared_ptr<BitTorrent::PeerEndpointBlocklist> peerEndpointBlocklist)
+            : m_connection {connection}
+            , m_peerEndpointBlocklist {std::move(peerEndpointBlocklist)}
+        {
+            disconnectIfBanned();
+        }
+
+    private:
+        void tick() override
+        {
+            disconnectIfBanned();
+        }
+
+        void disconnectIfBanned()
+        {
+            if (m_connection.is_disconnecting())
+                return;
+
+            if (m_peerEndpointBlocklist->contains(fromNativeEndpoint(m_connection.remote())))
+            {
+                m_connection.disconnect(lt::errors::peer_banned, lt::operation_t::bittorrent);
+            }
+        }
+
+        lt::peer_connection_handle m_connection;
+        std::shared_ptr<BitTorrent::PeerEndpointBlocklist> m_peerEndpointBlocklist;
+    };
+}
