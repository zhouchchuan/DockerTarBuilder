diff --git a/src/webui/www/test/private/misc.test.js b/src/webui/www/test/private/misc.test.js
index 19ac9de..c457728 100644
--- a/src/webui/www/test/private/misc.test.js
+++ b/src/webui/www/test/private/misc.test.js
@@ -131,3 +131,25 @@ test("Test formatDate() - Fallback Behavior", () => {
     // Restore original window.parent
     window.parent = originalParent;
 });
+
+test("Test buildTorrentUploadBatch()", () => {
+    const buildTorrentUploadBatch = window.qBittorrent.Misc.buildTorrentUploadBatch;
+    const singleTorrent = [{ infohash_v1: "hash-one" }];
+
+    expect(buildTorrentUploadBatch(singleTorrent, ["one.torrent"])).toBeNull();
+
+    const metadata = [
+        { infohash_v1: "hash-one" },
+        { infohash_v1: "legacy-two", infohash_v2: "hash-two" },
+    ];
+    const fileNames = ["one.torrent", "two.torrent"];
+    const result = buildTorrentUploadBatch(metadata, fileNames);
+
+    expect(result).toEqual({
+        batch: true,
+        torrents: metadata,
+        sources: ["hash-one", "hash-two"],
+        fileNames: fileNames,
+    });
+    expect(result.fileNames).not.toBe(fileNames);
+});
