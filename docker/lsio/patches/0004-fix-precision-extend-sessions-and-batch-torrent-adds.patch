diff --git a/src/base/preferences.cpp b/src/base/preferences.cpp
index c55095a..66ae34c 100644
--- a/src/base/preferences.cpp
+++ b/src/base/preferences.cpp
@@ -50,6 +50,9 @@
 
 namespace
 {
+    constexpr int LEGACY_WEB_UI_SESSION_TIMEOUT = 3600;
+    constexpr int PRECISION_WEB_UI_SESSION_TIMEOUT = 7 * 24 * 60 * 60;
+
     template <typename T>
     T value(const QString &key, const T &defaultValue = {})
     {
@@ -84,7 +87,22 @@ Preferences *Preferences::instance()
 void Preferences::initInstance()
 {
     if (!m_instance)
+    {
         m_instance = new Preferences;
+
+        // qBittorrent Precision keeps an authenticated WebUI session for seven
+        // days by default. Upgrade the upstream one-hour default once while
+        // preserving any timeout the administrator explicitly customized.
+        const QString migrationKey = u"Preferences/WebUI/PrecisionSessionTimeout7DaysApplied"_s;
+        if (!value(migrationKey, false))
+        {
+            const QString timeoutKey = u"Preferences/WebUI/SessionTimeout"_s;
+            if (value<int>(timeoutKey, LEGACY_WEB_UI_SESSION_TIMEOUT) == LEGACY_WEB_UI_SESSION_TIMEOUT)
+                setValue(timeoutKey, PRECISION_WEB_UI_SESSION_TIMEOUT);
+
+            setValue(migrationKey, true);
+        }
+    }
 }
 
 void Preferences::freeInstance()
@@ -945,7 +963,7 @@ void Preferences::setWebUIBanDuration(const std::chrono::seconds duration)
 
 int Preferences::getWebUISessionTimeout() const
 {
-    return value<int>(u"Preferences/WebUI/SessionTimeout"_s, 3600);
+    return value<int>(u"Preferences/WebUI/SessionTimeout"_s, PRECISION_WEB_UI_SESSION_TIMEOUT);
 }
 
 void Preferences::setWebUISessionTimeout(const int timeout)
